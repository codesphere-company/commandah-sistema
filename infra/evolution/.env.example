# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o GitHub.

# Endereço do servidor, sem https:// (ex.: commandah-whats.duckdns.org)
DOMINIO=
# Endereço anterior, atendido junto durante uma troca de endereço (deixe vazio depois).
DOMINIO_ANTIGO=

# Chave da Evolution: gere com  openssl rand -hex 32  e guarde no gerenciador de senhas.
# A mesma chave vai no Supabase como EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=

# Senha do banco interno da Evolution: gere com  openssl rand -hex 24
POSTGRES_PASSWORD=

# O Commandah liga o webhook por instância; o global fica desligado.
WEBHOOK_GLOBAL_ENABLED=false
# Guarda só o necessário (o histórico das conversas fica no Commandah, etapa 2).
DATABASE_SAVE_DATA_INSTANCE=true
# Etapa 2: a Evolution precisa guardar a mensagem para o Commandah abrir foto/PDF recebidos ("Ver foto").
# Mensagens com mais de 90 dias: apagar no VPS (README, Manutenção).
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
# Nome que aparece em "Aparelhos conectados" no celular.
CONFIG_SESSION_PHONE_CLIENT=Commandah
# Não apagar instância que ficou sem ler o QR (o Commandah apaga ao desconectar).
DEL_INSTANCE=false
QRCODE_LIMIT=30
LOG_LEVEL=ERROR,WARN
